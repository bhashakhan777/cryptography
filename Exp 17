#include <stdio.h>

int shifts[16]={1,1,2,2,2,2,2,2,1,2,2,2,2,2,2,1};

int main()
{
    unsigned int C[17],D[17];
    unsigned int C0,D0;
    int i;

    printf("Enter 28-bit C0 in hexadecimal: ");
    scanf("%x",&C0);

    printf("Enter 28-bit D0 in hexadecimal: ");
    scanf("%x",&D0);

    C[0]=C0;
    D[0]=D0;

    for(i=1;i<=16;i++)
    {
        int s=shifts[i-1];

        C[i]=((C[i-1]<<s)|(C[i-1]>>(28-s)))&0x0FFFFFFF;
        D[i]=((D[i-1]<<s)|(D[i-1]>>(28-s)))&0x0FFFFFFF;
    }

    printf("\nDES Decryption Shift Schedule:\n");

    for(i=16;i>=1;i--)
        printf("K%d uses C%d and D%d\n",i,i,i);

    printf("\nKeys are used in reverse order: K16 ... K1\n");

    return 0;
}
