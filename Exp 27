#include <stdio.h>

long long power(long long a,long long e,long long n)
{
    long long r=1;

    while(e)
    {
        if(e&1)
            r=(r*a)%n;

        a=(a*a)%n;
        e>>=1;
    }

    return r;
}

int main()
{
    long long n,e,c,m;

    printf("Enter RSA modulus n: ");
    scanf("%lld",&n);

    printf("Enter public exponent e: ");
    scanf("%lld",&e);

    printf("Enter ciphertext: ");
    scanf("%lld",&c);

    printf("\nBrute-force small plaintext attack:\n");

    for(m=0;m<26;m++)
    {
        if(power(m,e,n)==c)
        {
            printf("Possible plaintext: %lld\n",m);
            return 0;
        }
    }

    printf("No alphabetic plaintext found.\n");

    return 0;
}
