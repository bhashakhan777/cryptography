#include <stdio.h>
#include <math.h>

int main()
{
    long double keys = 1.0;
    int i;

    for(i=1;i<=25;i++)
        keys *= i;

    printf("Possible Playfair keys = 25! = %.0Lf\n", keys);
    printf("Approximate power of 2 = %.2Lf\n", log2l(keys));

    printf("\nConsidering equivalent transformations:\n");
    printf("Effective keys are approximately 2^%.2Lf\n",
           log2l(keys) - log2l(5*5*2));

    return 0;
}
