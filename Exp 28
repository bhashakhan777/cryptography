#include <stdio.h>

long long power(long long a,long long b,long long q)
{
    long long r=1;

    while(b)
    {
        if(b&1)
            r=(r*a)%q;

        a=(a*a)%q;
        b>>=1;
    }

    return r;
}

int main()
{
    long long a,q,x,y,A,B,key1,key2;

    printf("Enter public base a: ");
    scanf("%lld",&a);

    printf("Enter public prime q: ");
    scanf("%lld",&q);

    printf("Enter Alice secret x: ");
    scanf("%lld",&x);

    printf("Enter Bob secret y: ");
    scanf("%lld",&y);

    A=power(a,x,q);
    B=power(a,y,q);

    key1=power(B,x,q);
    key2=power(A,y,q);

    printf("Alice sends: %lld\n",A);
    printf("Bob sends: %lld\n",B);

    printf("Alice shared key: %lld\n",key1);
    printf("Bob shared key: %lld\n",key2);

    if(key1==key2)
        printf("Key agreement successful.\n");

    return 0;
}
