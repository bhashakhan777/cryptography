#include <stdio.h>
#include <string.h>

int gcd(int a, int b)
{
    while (b != 0)
    {
        int t = b;
        b = a % b;
        a = t;
    }

    return a;
}

int main()
{
    char text[100];
    int a, b;

    printf("Enter plaintext: ");
    scanf("%s", text);

    printf("Enter a: ");
    scanf("%d", &a);

    printf("Enter b: ");
    scanf("%d", &b);

    if (gcd(a, 26) != 1)
    {
        printf("Invalid value of a.\n");
        printf("a must be relatively prime to 26.\n");
        return 0;
    }

    printf("Ciphertext: ");

    for (int i = 0; text[i] != '\0'; i++)
    {
        int p = text[i] - 'A';
        int c = (a * p + b) % 26;

        printf("%c", c + 'A');
    }

    printf("\n");

    return 0;
}
