#include <stdio.h>

int gcd(long long a,long long b)
{
    while(b)
    {
        long long t=a%b;
        a=b;
        b=t;
    }
    return a;
}

int main()
{
    long long n,e,m,g;

    printf("Enter RSA modulus n: ");
    scanf("%lld",&n);

    printf("Enter public exponent e: ");
    scanf("%lld",&e);

    printf("Enter plaintext block suspected to share a factor with n: ");
    scanf("%lld",&m);

    g=gcd(m,n);

    if(g>1 && g<n)
    {
        printf("Common factor found: %lld\n",g);
        printf("RSA modulus can be factored.\n");
        printf("q = %lld\n",n/g);
    }
    else
        printf("No useful common factor found.\n");

    return 0;
}
