#include <stdio.h>
#include <string.h>

/* ---------- S-DES Tables ---------- */

int P10[] = {3,5,2,7,4,10,1,9,8,6};
int P8[]  = {6,3,7,4,8,5,10,9};
int IP[]  = {2,6,3,1,4,8,5,7};
int IP_INV[] = {4,1,3,5,7,2,8,6};
int EP[] = {4,1,2,3,2,3,4,1};
int P4[] = {2,4,3,1};

int S0[4][4] = {
    {1,0,3,2},
    {3,2,1,0},
    {0,2,1,3},
    {3,1,3,2}
};

int S1[4][4] = {
    {0,1,2,3},
    {2,0,1,3},
    {3,0,1,0},
    {2,1,0,3}
};

void permute(char *in, char *out, int *table, int n)
{
    for(int i=0;i<n;i++)
        out[i] = in[table[i]-1];

    out[n]='\0';
}

void leftShift(char *s,int n)
{
    char temp[6];

    for(int i=0;i<5;i++)
        temp[i]=s[(i+n)%5];

    temp[5]='\0';

    strcpy(s,temp);
}

void generateKeys(char *key,char *K1,char *K2)
{
    char p10[11],left[6],right[6],temp[11];

    permute(key,p10,P10,10);

    strncpy(left,p10,5);
    left[5]='\0';

    strncpy(right,p10+5,5);
    right[5]='\0';

    leftShift(left,1);
    leftShift(right,1);

    strcpy(temp,left);
    strcat(temp,right);

    permute(temp,K1,P8,8);

    leftShift(left,2);
    leftShift(right,2);

    strcpy(temp,left);
    strcat(temp,right);

    permute(temp,K2,P8,8);
}

void XOR(char *a,char *b,char *r,int n)
{
    for(int i=0;i<n;i++)
        r[i]=(a[i]==b[i])?'0':'1';

    r[n]='\0';
}

void sbox(char *bits,int S[4][4],char *output)
{
    int row,col,value;

    row=(bits[0]-'0')*2+(bits[3]-'0');
    col=(bits[1]-'0')*2+(bits[2]-'0');

    value=S[row][col];

    output[0]=(value/2)+'0';
    output[1]=(value%2)+'0';
    output[2]='\0';
}

void fk(char *bits,char *key,char *result)
{
    char left[5],right[5];
    char ep[9],x[9];
    char a[5],b[5];
    char s0[3],s1[3];
    char temp[5],p4[5];

    strncpy(left,bits,4);
    left[4]='\0';

    strncpy(right,bits+4,4);
    right[4]='\0';

    permute(right,ep,EP,8);

    XOR(ep,key,x,8);

    strncpy(a,x,4);
    a[4]='\0';

    strncpy(b,x+4,4);
    b[4]='\0';

    sbox(a,S0,s0);
    sbox(b,S1,s1);

    strcpy(temp,s0);
    strcat(temp,s1);

    permute(temp,p4,P4,4);

    XOR(left,p4,left,4);

    strcpy(result,left);
    strcat(result,right);
}

void SDES_Encrypt(char *plaintext,char *key,char *cipher)
{
    char K1[9],K2[9];
    char ip[9],temp[9],swap[9],result[9];

    generateKeys(key,K1,K2);

    permute(plaintext,ip,IP,8);

    fk(ip,K1,temp);

    strncpy(swap,temp+4,4);
    swap[4]='\0';

    strncat(swap,temp,4);

    fk(swap,K2,result);

    permute(result,cipher,IP_INV,8);
}

/* Increment 8-bit counter */
void incrementCounter(char *counter)
{
    int value=0;

    for(int i=0;i<8;i++)
        value=value*2+(counter[i]-'0');

    value=(value+1)%256;

    for(int i=7;i>=0;i--)
    {
        counter[i]=(value%2)+'0';
        value/=2;
    }
}

/* ---------- CTR Mode ---------- */

void CTR(char *input,char *output,char *key,char *counter)
{
    char currentCounter[9];
    char keystream[9];
    char block[9];

    strcpy(currentCounter,counter);

    for(int i=0;i<24;i+=8)
    {
        strncpy(block,input+i,8);
        block[8]='\0';

        /* Generate keystream */
        SDES_Encrypt(currentCounter,key,keystream);

        /* XOR input with keystream */
        XOR(block,keystream,output+i,8);

        /* Increment counter */
        incrementCounter(currentCounter);
    }

    output[24]='\0';
}

int main()
{
    char plaintext[] =
        "000000010000001000000100";

    char key[] =
        "0111111101";

    char counter[] =
        "00000000";

    char ciphertext[25];
    char decrypted[25];

    printf("CTR MODE USING S-DES\n");
    printf("----------------------------\n");

    printf("Plaintext : %s\n",plaintext);
    printf("Key       : %s\n",key);
    printf("Counter   : %s\n",counter);

    /* Encryption */
    CTR(plaintext,ciphertext,key,counter);

    printf("\nEncryption\n");
    printf("Ciphertext: %s\n",ciphertext);

    /* Decryption */
    CTR(ciphertext,decrypted,key,counter);

    printf("\nDecryption\n");
    printf("Decrypted : %s\n",decrypted);

    return 0;
}
