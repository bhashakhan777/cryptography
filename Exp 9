#include <stdio.h>
#include <string.h>

char matrix[5][5] =
{
    {'K','X','J','E','Y'},
    {'U','R','E','B','Z'},
    {'W','H','T','Y','F'},
    {'S','A','C','D','G'},
    {'O','N','L','P','Q'}
};

void find(char ch, int *r, int *c)
{
    int i, j;

    for(i=0;i<5;i++)
        for(j=0;j<5;j++)
            if(matrix[i][j] == ch)
            {
                *r=i;
                *c=j;
                return;
            }
}

int main()
{
    char cipher[200];
    int i, r1,c1,r2,c2;

    printf("Enter Playfair ciphertext: ");
    scanf(" %[^\n]", cipher);

    printf("Plaintext: ");

    for(i=0; cipher[i] && cipher[i+1]; i+=2)
    {
        find(cipher[i], &r1,&c1);
        find(cipher[i+1], &r2,&c2);

        if(r1 == r2)
        {
            printf("%c%c",
                   matrix[r1][(c1+4)%5],
                   matrix[r2][(c2+4)%5]);
        }
        else if(c1 == c2)
        {
            printf("%c%c",
                   matrix[(r1+4)%5][c1],
                   matrix[(r2+4)%5][c2]);
        }
        else
        {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }

    return 0;
}
