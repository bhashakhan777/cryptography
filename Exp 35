#include <stdio.h>
#include <string.h>

int main()
{
    char plaintext[100];
    int key[100];
    int cipher[100];
    int n;

    printf("Enter plaintext: ");
    scanf("%s", plaintext);

    n = strlen(plaintext);

    printf("Enter %d random key values (0-25):\n", n);

    for (int i = 0; i < n; i++)
        scanf("%d", &key[i]);

    printf("Ciphertext: ");

    for (int i = 0; i < n; i++)
    {
        cipher[i] = ((plaintext[i] - 'A') + key[i]) % 26;
        printf("%c", cipher[i] + 'A');
    }

    printf("\n");

    return 0;
}
