#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[200];
    int key[200];
    int n,i,j=0;

    printf("Enter plaintext: ");
    fgets(text,sizeof(text),stdin);

    printf("Enter number of key values: ");
    scanf("%d",&n);

    printf("Enter key values (0-25): ");
    for(i=0;i<n;i++)
        scanf("%d",&key[i]);

    printf("Ciphertext: ");

    for(i=0;text[i]!='\0';i++)
    {
        if(isalpha(text[i]))
        {
            int p=toupper(text[i])-'A';
            int c=(p+key[j])%26;

            printf("%c",c+'A');
            j++;
        }
        else
            printf("%c",text[i]);
    }

    return 0;
}
