#include <stdio.h>
#include <ctype.h>

char matrix[5][5] =
{
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void find(char ch, int *r, int *c)
{
    int i,j;

    if(ch == 'J') ch = 'I';

    for(i=0;i<5;i++)
        for(j=0;j<5;j++)
            if(matrix[i][j] == ch)
            {
                *r=i;
                *c=j;
                return;
            }
}

int main()
{
    char text[200], p[200];
    int n=0,i,r1,c1,r2,c2;

    printf("Enter message: ");
    fgets(text,sizeof(text),stdin);

    for(i=0;text[i];i++)
        if(isalpha(text[i]))
        {
            char ch=toupper(text[i]);
            if(ch=='J') ch='I';
            p[n++]=ch;
        }

    if(n%2)
        p[n++]='X';

    printf("Ciphertext: ");

    for(i=0;i<n;i+=2)
    {
        find(p[i],&r1,&c1);
        find(p[i+1],&r2,&c2);

        if(r1==r2)
            printf("%c%c",matrix[r1][(c1+1)%5],
                           matrix[r2][(c2+1)%5]);
        else if(c1==c2)
            printf("%c%c",matrix[(r1+1)%5][c1],
                           matrix[(r2+1)%5][c2]);
        else
            printf("%c%c",matrix[r1][c2],
                           matrix[r2][c1]);
    }

    return 0;
}
