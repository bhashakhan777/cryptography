#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char keyword[50], cipher[27];
    int used[26] = {0};
    int i, n = 0;
    char ch;

    printf("Enter keyword: ");
    scanf("%s", keyword);

    for(i = 0; keyword[i]; i++)
    {
        ch = toupper(keyword[i]);

        if(ch >= 'A' && ch <= 'Z' && !used[ch-'A'])
        {
            cipher[n++] = ch;
            used[ch-'A'] = 1;
        }
    }

    for(ch = 'A'; ch <= 'Z'; ch++)
    {
        if(!used[ch-'A'])
            cipher[n++] = ch;
    }

    cipher[n] = '\0';

    printf("Plain : ABCDEFGHIJKLMNOPQRSTUVWXYZ\n");
    printf("Cipher: %s\n", cipher);

    return 0;
}
