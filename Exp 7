#include <stdio.h>
#include <string.h>

int main()
{
    char cipher[2000];
    char key[27];
    int i;

    printf("Enter ciphertext:\n");
    fgets(cipher, sizeof(cipher), stdin);

    printf("Enter substitution key for A-Z:\n");
    scanf("%26s", key);

    printf("\nPlaintext:\n");

    for(i = 0; cipher[i] != '\0'; i++)
    {
        if(cipher[i] >= 'A' && cipher[i] <= 'Z')
            printf("%c", key[cipher[i]-'A']);
        else if(cipher[i] >= 'a' && cipher[i] <= 'z')
            printf("%c", key[cipher[i]-'a']);
        else
            printf("%c", cipher[i]);
    }

    return 0;
}
